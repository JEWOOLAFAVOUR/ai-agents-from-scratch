# Hi pals this file is to be copied to the (.env) file you created and fill in your Gemini API key.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# note I also use minstral as back-up because my gemini free limit get exceded sometimes so get the key from minstral console
# Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_minstral_api_key_here

# for now I use groq api since it's abit free and can help me with the classes 
GROQ_API_KEY=kdkkd
GROQ_MODEL="openai/gpt-oss-120b"

# to get groq key check here - https://console.groq.com/
